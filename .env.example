# Choose `ollama` for a local model or `openai` for OpenAI's API.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OPENAI_API_KEY=replace-with-your-key-when-LLM_PROVIDER-is-openai
OPENAI_MODEL=gpt-4o-mini

# Chroma reuses the existing chroma_db directory. FAISS uses faiss_db.
VECTOR_DB=chroma
